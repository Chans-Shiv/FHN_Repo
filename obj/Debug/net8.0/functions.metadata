[
  {
    "name": "ScheduledSync",
    "scriptFile": "SqlToDataverseSync.dll",
    "entryPoint": "SqlToDataverseSync.Functions.ScheduledSyncFunction.Run",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "timerInfo",
        "direction": "In",
        "type": "timerTrigger",
        "schedule": "%SyncScheduleCron%",
        "properties": {}
      }
    ]
  }
]