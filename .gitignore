# ──────────────────────────────────────────────
# Azure Functions / .NET 8 Isolated Worker
# ──────────────────────────────────────────────

# Local secrets — DO NOT COMMIT.
# Contains SqlConnectionString, DataverseUrl, AzureTenantId, etc.
# If you need a template for new devs, commit a local.settings.example.json instead.
local.settings.json

# Other common secret-bearing files — committing any of these is almost always
# a mistake. Cheap insurance even if we don't use them today.
.env
.env.*
!.env.example
secrets.json
appsettings.*.local.json
*.pfx
*.snk

# Azure Functions Core Tools cache + runtime artifacts
.azure/
.azurefunctions/
azurite_*
__azurite_db_*__.json
__blobstorage__/
__queuestorage__/

# ──────────────────────────────────────────────
# Build outputs
# ──────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.dll
*.exe
*.pdb
*.sym
*.cache
*.tlog
*.lastbuildstate

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

# Publish
[Pp]ublish/
PublishScripts/
*.[Pp]ublish.xml
*.publishsettings
*.azurePubxml

